---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { getTopicSlug } from '../utils/topics';

type Props = Omit<CollectionEntry<'blog'>['data'], 'author'> & {
	author?: CollectionEntry<'authors'>['data'];
};

const { title, description, pubDate, updatedDate, heroImage, author, tags = [], category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: min(1040px, calc(100% - 48px));
			}
			.hero-image {
				max-width: 920px;
				margin: 0 auto 38px;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				border: 1px solid #252a37;
				border-radius: 3px;
				object-fit: cover;
				box-shadow: var(--box-shadow);
				filter: saturate(0.78);
			}
			.prose {
				width: min(720px, 100%);
				margin: 0 auto;
				color: #c0c8d6;
			}
			.title {
				margin-bottom: 34px;
				padding: 0 0 22px;
				border-bottom: 1px solid #252a37;
				text-align: left;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.4rem, 6vw, 4.25rem);
				letter-spacing: -0.055em;
			}
			.date {
				margin-bottom: 14px;
				color: var(--accent);
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-size: 0.72rem;
			}
			.last-updated-on {
				margin-top: 5px;
				color: #8791a4;
				font-style: normal;
			}
			.post-topics {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
				margin: 18px 0 0;
				padding: 0;
				list-style: none;
			}
			.topic-link {
				display: inline-flex;
				align-items: center;
				gap: 7px;
				min-height: 30px;
				padding: 4px 10px;
				border: 1px solid #293044;
				border-radius: 2px;
				background: #0b0e15;
				color: #bdc7d8;
				font-size: 0.75rem;
				line-height: 1.3;
				text-decoration: none;
				transition:
					border-color 160ms ease,
					background 160ms ease,
					color 160ms ease;
			}
			.topic-kind {
				color: #7f899c;
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-size: 0.59rem;
				letter-spacing: 0.1em;
			}
			.topic-category {
				border-left: 2px solid var(--signal-red);
			}
			.topic-category .topic-kind {
				color: var(--signal-red);
			}
			.topic-tag .topic-hash {
				color: var(--accent);
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-weight: 700;
			}
			.topic-link:hover,
			.topic-link:focus-visible {
				border-color: var(--accent);
				background: #101722;
				color: #f4f6fb;
			}
			.topic-link:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
			}
			@media (max-width: 720px) {
				main {
					width: calc(100% - 36px);
				}
				.hero-image {
					margin-bottom: 28px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							(category || tags.length > 0) && (
								<ul class="post-topics" aria-label={`Topics for ${title}`}>
									{category && (
										<li>
											<a
												class="topic-link topic-category"
												href={`/blog/categories/${getTopicSlug(category)}/`}
												aria-label={`Category: ${category}`}
											>
												<span class="topic-kind">CATEGORY /</span>
												<span class="topic-name">{category}</span>
											</a>
										</li>
									)}
									{tags.map((tag) => (
										<li>
											<a class="topic-link topic-tag" href={`/blog/tags/${getTopicSlug(tag)}/`}>
												<span class="topic-hash" aria-hidden="true">#</span>
												<span class="topic-name">{tag}</span>
												<span class="sr-only"> tag</span>
											</a>
										</li>
									))}
								</ul>
							)
						}
						<hr />
					</div>
					<slot />
					{author && <AuthorBio {...author} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
