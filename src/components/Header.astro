---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav aria-label="Main navigation">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="wordmark-mark" aria-hidden="true">[&gt;]</span>
			<span>{SITE_TITLE}<span class="wordmark-period">.</span></span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Journal</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
		<a class="github-link" href="https://github.com/DandarGaming" target="_blank" rel="me noopener noreferrer">
			GitHub <span aria-hidden="true">↗</span>
		</a>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-inline: max(24px, calc((100% - 1120px) / 2));
		border-bottom: 1px solid #202430;
		background: #05060a;
	}

	nav {
		display: flex;
		min-height: 78px;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #f4f6fb;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark-mark,
	.wordmark-period {
		color: var(--signal-red);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: clamp(16px, 3vw, 38px);
	}

	.internal-links :global(a) {
		padding-block: 8px;
		color: #9299a9;
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: #f4f6fb;
	}

	.internal-links :global(a.active::before) {
		content: "/";
		margin-right: 6px;
		color: var(--accent);
	}

	.github-link {
		color: var(--accent);
		font-size: 0.82rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.github-link span {
		margin-left: 6px;
		color: var(--signal-red);
	}

	@media (max-width: 560px) {
		.site-header {
			padding-inline: 18px;
		}

		nav {
			min-height: 68px;
			gap: 10px;
		}

		.wordmark {
			gap: 7px;
			font-size: 0.78rem;
		}

		.internal-links {
			gap: 12px;
		}

		.internal-links :global(a) {
			font-size: 0.73rem;
		}

		.internal-links :global(a.active::before) {
			margin-right: 3px;
		}

		.github-link {
			font-size: 0.72rem;
		}
	}

	@media (max-width: 390px) {
		.github-link {
			display: none;
		}
	}
</style>
