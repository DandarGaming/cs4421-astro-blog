---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SocialLinks from './SocialLinks.astro';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, socialLinks } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-bio-title">
	<h2 id="author-bio-title">About the author</h2>
	<div class="author-content">
		<Image class="author-avatar" width={96} height={96} src={avatar} alt={`Portrait of ${name}`} />
		<div>
			<h3>{name}</h3>
			<p>{bio}</p>
			<SocialLinks name={name} links={socialLinks} />
		</div>
	</div>
</section>

<style>
	.author-bio {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-bio h2 {
		font-size: 1.5em;
	}
	.author-content {
		display: flex;
		gap: 1.25em;
		align-items: flex-start;
		color: #aab3c5;
	}
	.author-avatar {
		flex: 0 0 auto;
		width: 96px;
		height: 96px;
		border: 1px solid #303747;
		border-radius: 50%;
		object-fit: cover;
	}
	.author-content h3 {
		margin-bottom: 0.25em;
		font-size: 1.25em;
	}
	.author-content p {
		margin: 0 0 0.75em;
	}
	@media (max-width: 480px) {
		.author-content {
			flex-direction: column;
		}
	}
</style>
