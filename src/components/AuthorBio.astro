---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, socialLinks } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-bio-title">
	<h2 id="author-bio-title">About the author</h2>
	<div class="author-content">
		<Image class="author-avatar" width={96} height={96} src={avatar} alt={`Portrait of ${name}`} />
		<div>
			<h3>{name}</h3>
			<p>{bio}</p>
			{
				socialLinks.length > 0 && (
					<nav aria-label={`${name}'s social links`}>
						<ul class="social-links">
							{socialLinks.map(({ label, url }) => (
								<li>
									<a href={url} rel="me noopener noreferrer">{label}</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>
</section>

<style>
	.author-bio {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-bio h2 {
		font-size: 1.5em;
	}
	.author-content {
		display: flex;
		gap: 1.25em;
		align-items: flex-start;
	}
	.author-avatar {
		flex: 0 0 auto;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
	}
	.author-content h3 {
		margin-bottom: 0.25em;
		font-size: 1.25em;
	}
	.author-content p {
		margin: 0 0 0.75em;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em 1em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 480px) {
		.author-content {
			flex-direction: column;
		}
	}
</style>
