---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<a class="footer-mark" href="/" aria-label={`Back to ${SITE_TITLE} home`}>[&gt;]</a>
	<p>BUILT BY DANDAR <span aria-hidden="true">—</span> ALWAYS A WORK IN PROGRESS.</p>
	<a href="https://github.com/DandarGaming" target="_blank" rel="me noopener noreferrer">
		GITHUB <span aria-hidden="true">↗</span>
	</a>
	<small>&copy; {today.getFullYear()}</small>
</footer>

<style>
	.site-footer {
		display: flex;
		width: min(1120px, calc(100% - 48px));
		min-height: 82px;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		margin-inline: auto;
		border-top: 1px solid #202430;
		color: #798194;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.61rem;
		letter-spacing: 0.07em;
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer p span,
	.site-footer > a:last-of-type {
		color: var(--accent);
	}

	.site-footer a {
		text-decoration: none;
	}

	.site-footer .footer-mark {
		color: var(--signal-red);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.site-footer > a:last-of-type span {
		color: var(--signal-red);
	}

	.site-footer small {
		color: #697184;
		font: inherit;
	}

	@media (max-width: 560px) {
		.site-footer {
			width: calc(100% - 36px);
			min-height: 72px;
			gap: 12px;
			font-size: 0.5rem;
		}
	}
</style>
