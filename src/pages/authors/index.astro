---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const authors = await getCollection('authors');
const posts = await getCollection('blog');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Authors | ${SITE_TITLE}`} description="Meet the writers behind the journal." />
	</head>
	<body>
		<Header />
		<main>
			<section class="authors" aria-labelledby="authors-title">
				<p class="eyebrow"><span aria-hidden="true">03 /</span> THE AUTHORS</p>
				<h1 id="authors-title">People behind the posts<span>.</span></h1>
				<p class="intro">Meet the writers sharing their projects, experiments, and lessons.</p>

				<ul class="author-list">
					{
						authors.map((author) => {
							const postCount = posts.filter((post) => post.data.author.id === author.id).length;

							return (
								<li>
									<a class="author-card" href={`/authors/${author.id}/`}>
										<Image
											class="author-avatar"
											width={104}
											height={104}
											src={author.data.avatar}
											alt={`Portrait of ${author.data.name}`}
										/>
										<span class="author-copy">
											<span class="author-name">{author.data.name}</span>
											<span class="author-bio">{author.data.bio}</span>
											<span class="author-post-count">
												{postCount} {postCount === 1 ? 'published post' : 'published posts'}
											</span>
										</span>
										<span class="author-arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.authors {
		width: min(960px, 100%);
		margin-inline: auto;
	}

	.eyebrow {
		margin: 0 0 16px;
		color: #9ba4b7;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.67rem;
		letter-spacing: 0.12em;
	}

	.eyebrow span,
	h1 span {
		color: var(--signal-red);
	}

	h1 {
		margin-bottom: 12px;
		font-size: clamp(2.4rem, 6vw, 4.25rem);
	}

	.intro {
		max-width: 630px;
		margin-bottom: 38px;
		color: #aab3c5;
	}

	.author-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid #252a37;
		list-style: none;
	}

	.author-list li {
		border-bottom: 1px solid #252a37;
	}

	.author-card {
		display: grid;
		grid-template-columns: 104px minmax(0, 1fr) 22px;
		align-items: center;
		gap: 24px;
		padding: 22px 8px;
		color: inherit;
		text-decoration: none;
	}

	.author-card:hover {
		background: #10131b;
	}

	.author-avatar {
		width: 104px;
		height: 104px;
		margin: 0;
		border: 1px solid #303747;
		border-radius: 50%;
		object-fit: cover;
	}

	.author-copy {
		display: flex;
		flex-direction: column;
		align-items: start;
	}

	.author-name {
		color: #f4f6fb;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.author-bio {
		color: #aab3c5;
		font-size: 0.9rem;
	}

	.author-post-count {
		margin-top: 7px;
		color: #8791a4;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
	}

	.author-arrow {
		align-self: start;
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.author-card {
			grid-template-columns: 76px minmax(0, 1fr) 18px;
			gap: 14px;
			padding-inline: 4px;
		}

		.author-avatar {
			width: 76px;
			height: 76px;
		}
	}
</style>
