---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { supabasePublishableKey, supabaseUrl } from '../../lib/supabase';

const supabaseKey = supabasePublishableKey;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Admin login | ${SITE_TITLE}`} description="Private administration area." />
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</head>
	<body>
		<main>
			<section
				class="admin-shell"
				aria-labelledby="admin-title"
				data-supabase-url={supabaseUrl}
				data-supabase-key={supabaseKey}
			>
				<p class="eyebrow">PRIVATE AREA</p>
				<h1 id="admin-title">Admin login<span>.</span></h1>
				<p class="intro">Sign in to manage unpublished drafts.</p>

				<form id="login-form">
					<label>
						<span>Email</span>
						<input id="email" type="email" autocomplete="username" required />
					</label>
					<label>
						<span>Password</span>
						<input id="password" type="password" autocomplete="current-password" required />
					</label>
					<button type="submit">Sign in</button>
				</form>

				<div id="admin-app" hidden>
					<div class="app-heading">
						<div>
							<p class="eyebrow">DRAFT MANAGEMENT</p>
							<h2>Draft desk<span>.</span></h2>
						</div>
						<button id="sign-out" class="secondary" type="button">Sign out</button>
					</div>
					<div class="toolbar">
						<label>
							<span>Search drafts</span>
							<input id="draft-search" type="search" placeholder="Search by title..." />
						</label>
						<label>
							<span>Filter category</span>
							<select id="category-filter"><option value="">All categories</option></select>
						</label>
					</div>
					<section class="new-category" aria-labelledby="new-category-title">
						<h3 id="new-category-title">Create a category</h3>
						<form id="new-category-form">
							<label>
								<span>Category name</span>
								<input id="new-category-name" required maxlength="48" />
							</label>
							<label>
								<span>Assign to draft</span>
								<select id="new-category-draft" required></select>
							</label>
							<button type="submit">Create and assign</button>
						</form>
					</section>
					<div id="draft-list" class="draft-list"></div>
				</div>
				<p id="admin-message" class="message" role="status" aria-live="polite"></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script src="../../scripts/admin.ts"></script>

<style>
	.admin-shell { width: min(960px, 100%); margin: 0 auto; }
	.eyebrow { color: #9ba4b7; font-family: ui-monospace, monospace; font-size: .67rem; letter-spacing: .12em; }
	.eyebrow, h1 span, h2 span { color: var(--signal-red); }
	h1 { margin-bottom: 10px; } h2 { margin: 0; } h1 span, h2 span { color: var(--signal-red); }
	.intro, .draft-meta { color: #aab3c5; }
	form { display: grid; gap: 14px; max-width: 420px; margin-top: 28px; }
	label, fieldset { color: #aab3c5; font-size: .78rem; }
	label > span, legend { display: block; margin-bottom: 6px; color: #8791a4; font-size: .68rem; text-transform: uppercase; }
	input, select, button { min-height: 42px; } input, select { width: 100%; }
	button { padding: .55em .9em; border: 1px solid var(--accent); border-radius: 3px; background: #0c2738; color: #f4f6fb; cursor: pointer; font: inherit; font-size: .78rem; }
	button:hover { background: #123d56; } button.secondary { background: transparent; }
	.message { min-height: 1.7em; color: #86ceff; font-size: .8rem; } .message.error { color: var(--signal-red); }
	.app-heading { display: flex; align-items: end; justify-content: space-between; margin: 36px 0 24px; }
	.toolbar, .new-category form { display: flex; flex-wrap: wrap; gap: 14px; align-items: end; max-width: none; }
	.toolbar { margin-bottom: 24px; } .toolbar label { flex: 1 1 260px; }
	.new-category { margin: 20px 0 34px; padding: 18px; border: 1px solid #252a37; background: #090b11; }
	.new-category h3 { margin: 0 0 16px; } .new-category label { flex: 1 1 220px; }
	.draft-list { display: grid; gap: 18px; } .draft-card { padding: 22px; border: 1px solid #252a37; background: #090b11; }
	.draft-card h3 { margin-bottom: 4px; } .draft-meta { margin: 0 0 18px; font-size: .78rem; }
	fieldset { margin: 0 0 18px; padding: 0; border: 0; } .category-options { display: flex; flex-wrap: wrap; gap: 10px 16px; }
	.category-options label { display: flex; align-items: center; gap: 7px; color: #dce2ed; } .category-options input { width: auto; min-height: auto; }
	.empty-state { padding: 24px; border: 1px dashed #303747; color: #aab3c5; }
</style>
