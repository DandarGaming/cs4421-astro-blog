---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { getTopicSlug } from '../../../utils/topics';

type TopicType = 'tags' | 'categories';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const topics = new Map<
		string,
		{ type: TopicType; label: string; posts: typeof posts }
	>();

	for (const post of posts) {
		const postTopics: Array<{ type: TopicType; label: string }> = [
			...post.data.tags.map((label) => ({ type: 'tags' as const, label })),
			...(post.data.category ? [{ type: 'categories' as const, label: post.data.category }] : []),
		];

		for (const { type, label } of postTopics) {
			const slug = getTopicSlug(label);
			const key = `${type}/${slug}`;
			const topic = topics.get(key);
			if (topic) {
				topic.posts.push(post);
			} else {
				topics.set(key, { type, label, posts: [post] });
			}
		}
	}

	return [...topics].map(([key, topic]) => {
		const [, slug] = key.split('/');
		return {
			params: { type: topic.type, topic: slug },
			props: {
				...topic,
				posts: topic.posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
			},
		};
	});
}

const { type, label, posts } = Astro.props as {
	type: TopicType;
	label: string;
	posts: Awaited<ReturnType<typeof getCollection<'blog'>>>;
};
const topicKind = type === 'tags' ? 'Tag' : 'Category';
const pageTitle = `${label} ${topicKind.toLowerCase()} | ${SITE_TITLE}`;
const description = `Browse blog posts in the ${topicKind.toLowerCase()} "${label}".`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="topic-page" aria-labelledby="topic-title">
				<nav aria-label="Breadcrumb">
					<a href="/blog/">Journal</a>
					<span aria-hidden="true"> / </span>
					<span>{topicKind}</span>
				</nav>
				<p class="eyebrow">{topicKind.toUpperCase()} / TOPIC ARCHIVE</p>
				<h1 id="topic-title">{label}<span>.</span></h1>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="post-title">{post.data.title}</span>
								<span class="post-description">{post.data.description}</span>
								<span class="read-link">Read entry <span aria-hidden="true">→</span></span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.topic-page {
		width: min(960px, 100%);
		margin-inline: auto;
	}

	nav {
		margin-bottom: 34px;
		color: #8791a4;
		font-size: 0.82rem;
	}

	nav a {
		color: var(--accent);
	}

	.eyebrow {
		margin-bottom: 14px;
		color: #9ba4b7;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.67rem;
		letter-spacing: 0.12em;
	}

	h1 {
		margin-bottom: 36px;
		font-size: clamp(2.4rem, 6vw, 4.25rem);
	}

	h1 span {
		color: var(--signal-red);
	}

	.post-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid #252a37;
		list-style: none;
	}

	.post-list li {
		border-bottom: 1px solid #252a37;
	}

	.post-list li > a {
		display: flex;
		flex-direction: column;
		align-items: start;
		padding: 22px 8px;
		color: inherit;
		text-decoration: none;
	}

	.post-list li > a:hover {
		background: #10131b;
	}

	.post-date {
		margin-bottom: 6px;
		color: #8791a4;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
	}

	.post-title {
		color: #f4f6fb;
		font-size: 1.3rem;
		font-weight: 700;
	}

	.post-description {
		margin-top: 5px;
		color: #aab3c5;
		font-size: 0.86rem;
	}

	.read-link {
		margin-top: 10px;
		color: var(--accent);
		font-size: 0.75rem;
	}

	.read-link span {
		color: var(--signal-red);
	}

</style>
