---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-page">
		<header class="site-header">
			<a class="wordmark" href="/" aria-label={`${SITE_TITLE} home`}>
				<span class="wordmark-mark" aria-hidden="true">[&gt;]</span>
				<span>{SITE_TITLE}<span class="wordmark-period">.</span></span>
			</a>
			<nav aria-label="Main navigation">
				<a class="nav-link is-current" href="/" aria-current="page">Home</a>
				<a class="nav-link" href="/blog/">Journal</a>
				<a class="nav-link" href="/about/">About</a>
			</nav>
			<a class="header-cta" href="/blog/">Enter the blog <span aria-hidden="true">↗</span></a>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
						<p class="eyebrow"><span class="status-light" aria-hidden="true"></span> DANDAR / SOFTWARE & SIDE QUESTS</p>
						<h1 id="hero-title">Building<br />things, one<br /><span>idea</span> at a time<span class="title-cursor" aria-hidden="true">_</span></h1>
					<p class="hero-description">
							I’m Dandar, an ISE student at the University of Limerick and creator of Mizo AI.
							This is my corner for projects, experiments, and things I learn along the way.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="/blog/">
							Explore the journal <span aria-hidden="true">→</span>
						</a>
						<a class="text-link" href="#latest">Scroll the feed <span aria-hidden="true">↓</span></a>
					</div>
					<div class="hero-meta">
						<span><span class="meta-dot blue-dot" aria-hidden="true"></span> JAVA / JAVASCRIPT / PYTHON</span>
						<span>LEARNING IN PUBLIC</span>
					</div>
				</div>

				<div class="bonsai-scene">
					<pre id="bonsai-tree" aria-hidden="true"></pre>
					<div class="bonsai-caption">
						<span class="caption-mark" aria-hidden="true">✳</span>
						<span>Growing at its own pace.</span>
					</div>
				</div>
			</section>

			<section class="manifesto" aria-label="About this blog">
				<p class="section-index">01 <span>/</span> A LITTLE CONTEXT</p>
				<div>
					<h2>Part coursework. Part curiosity.</h2>
					<p>
						From building Mizo AI to trying out a new language or framework, this blog is where I keep
						the useful bits: what worked, what didn’t, and what I want to remember next time.
					</p>
				</div>
				<a class="manifesto-link" href="https://github.com/DandarGaming" target="_blank" rel="me noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a>
			</section>

			<section class="latest" id="latest" aria-labelledby="latest-title">
				<div class="latest-heading">
					<div>
						<p class="section-index">02 <span>/</span> LATEST NOTES</p>
						<h2 id="latest-title">Fresh from the log<span class="red-period">.</span></h2>
					</div>
					<a class="all-posts-link" href="/blog/">View all entries <span aria-hidden="true">↗</span></a>
				</div>
				<ul class="post-list">
					{
						posts.map((post, index) => (
							<li>
								<a class="post-link" href={`/blog/${post.id}/`}>
									<span class="post-number">{String(index + 1).padStart(2, '0')}</span>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="post-arrow" aria-hidden="true">↗</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer class="site-footer">
			<a class="footer-mark" href="/" aria-label="Back to top">[&gt;]</a>
			<p>BUILT BY DANDAR <span aria-hidden="true">—</span> ALWAYS A WORK IN PROGRESS.</p>
			<a href="https://github.com/DandarGaming" target="_blank" rel="me noopener noreferrer">GITHUB <span aria-hidden="true">↗</span></a>
		</footer>

		<script>
			const scene = document.querySelector('#bonsai-tree');
			const width = 56;
			const height = 22;
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const seed = new Uint32Array(1);
			window.crypto.getRandomValues(seed);
			let randomState = seed[0] || 1;
			const random = () => {
				randomState ^= randomState << 13;
				randomState ^= randomState >>> 17;
				randomState ^= randomState << 5;
				return (randomState >>> 0) / 4294967296;
			};
			const randomInt = (min, max) => Math.floor(random() * (max - min + 1)) + min;
			const trunkOffset = randomInt(-2, 2);
			const varyPath = (points, spread = 1) => points.map(([x, y], index) => [
				x + trunkOffset + (index > 0 && index < points.length - 1 ? randomInt(-spread, spread) : 0),
				y,
			]);
			const trunkPath = varyPath([[28, 20], [27, 18], [25, 16], [25, 14], [27, 12], [30, 10], [31, 8]], 0);
			const branches = [
				{ points: [[25, 16], [22, 15], [19, 15], [16, 13], [14, 12]], stage: 1 },
				{ points: [[19, 15], [17, 13], [14, 13]], stage: 2 },
				{ points: [[25, 16], [28, 15], [32, 15], [35, 13], [38, 12]], stage: 1 },
				{ points: [[32, 15], [35, 15], [39, 14], [42, 12]], stage: 2 },
				{ points: [[26, 14], [23, 12], [20, 11], [17, 11]], stage: 2 },
				{ points: [[30, 10], [33, 9], [36, 7], [39, 7]], stage: 3 },
				{ points: [[27, 12], [27, 10], [25, 9]], stage: 3 },
			].map((branch) => ({ ...branch, points: varyPath(branch.points, 2) }));
			const foliage = [
				{ x: 14, y: 10, radiusX: 5, radiusY: 2, stage: 1 },
				{ x: 21, y: 9, radiusX: 5, radiusY: 2, stage: 2 },
				{ x: 29, y: 7, radiusX: 5, radiusY: 2, stage: 3 },
				{ x: 37, y: 8, radiusX: 5, radiusY: 2, stage: 2 },
				{ x: 43, y: 10, radiusX: 3, radiusY: 2, stage: 3 },
			].map((cluster) => ({
				...cluster,
				x: cluster.x + trunkOffset + randomInt(-2, 2),
				y: cluster.y + randomInt(-1, 1),
				radiusX: cluster.radiusX + randomInt(-1, 1),
				radiusY: cluster.radiusY + randomInt(-1, 1),
				textureSeed: random() * 100,
			}));
			let growth = reducedMotion.matches ? 4 : randomInt(1, 2);
			let leafPhase = 0;
			let growthTicks = 0;
			let timer;

			function renderBonsai() {
				const cells = Array.from({ length: height }, () =>
					Array.from({ length: width }, () => ({ char: ' ', className: 'tree-branch' })),
				);
				const put = (x, y, char, className) => {
					const column = Math.round(x);
					const row = Math.round(y);
					if (column >= 0 && column < width && row >= 0 && row < height) {
						cells[row][column] = { char, className };
					}
				};

				const drawPath = (points, stage, className = 'tree-branch') => {
					if (stage > growth) return;

					for (let segment = 1; segment < points.length; segment += 1) {
						const [startX, startY] = points[segment - 1];
						const [endX, endY] = points[segment];
						const steps = Math.max(Math.abs(endX - startX), Math.abs(endY - startY)) * 2;
						for (let step = 0; step <= steps; step += 1) {
							const progress = step / steps;
							const x = startX + (endX - startX) * progress;
							const y = startY + (endY - startY) * progress;
							const char = Math.abs(endX - startX) > Math.abs(endY - startY)
								? (endX > startX ? '\\' : '/')
								: '|';
							put(x, y, char, className);
						}
					}
				};

				foliage.forEach((cluster, clusterIndex) => {
					if (growth < cluster.stage) return;
					for (let y = -cluster.radiusY; y <= cluster.radiusY; y += 1) {
						for (let x = -cluster.radiusX; x <= cluster.radiusX; x += 1) {
							const shape = (x * x) / (cluster.radiusX * cluster.radiusX)
								+ (y * y) / (cluster.radiusY * cluster.radiusY);
							const texture = Math.sin((x + 2) * 12.3 + (y + 3) * 5.7 + cluster.textureSeed) > -0.12;
							if (shape <= 1 && texture) {
								const shimmer = Math.sin(leafPhase + x * 0.8 + y * 1.1 + clusterIndex) > 0.82;
								const leaf = shimmer ? '*' : (Math.abs(x + y) % 3 === 0 ? '#' : '&');
								put(cluster.x + x, cluster.y + y, leaf, shimmer ? 'tree-leaf-light' : 'tree-leaf');
							}
						}
					}
				});

				drawPath(trunkPath, 0, 'tree-trunk');
				branches.forEach(({ points, stage }) => drawPath(points, stage));

				put(22 + trunkOffset, 20, '/', 'tree-pot');
				for (let column = 23; column <= 33; column += 1) {
					put(column + trunkOffset, 20, '_', 'tree-pot');
					put(column + trunkOffset, 21, '_', 'tree-pot');
				}
				put(34 + trunkOffset, 20, '\\', 'tree-pot');
				put(22 + trunkOffset, 21, '\\', 'tree-pot');
				put(34 + trunkOffset, 21, '/', 'tree-pot');
				put(28 + trunkOffset, 19, '|', 'tree-trunk');

				const fragment = document.createDocumentFragment();
				cells.forEach((row, rowIndex) => {
					let text = '';
					let currentClass = row[0].className;
					const appendRun = () => {
						const span = document.createElement('span');
						span.className = currentClass;
						span.textContent = text;
						fragment.append(span);
					};
					row.forEach(({ char, className }) => {
						if (className !== currentClass) {
							appendRun();
							text = '';
							currentClass = className;
						}
						text += char;
					});
					appendRun();
					if (rowIndex < height - 1) fragment.append(document.createTextNode('\n'));
				});
				scene.replaceChildren(fragment);
			}

			function startAnimation() {
				if (timer || reducedMotion.matches) return;
				timer = window.setInterval(() => {
					leafPhase += 0.24;
					growthTicks += 1;
					if (growth < 3 && growthTicks % 3 === 0) growth += 1;
					renderBonsai();
				}, 1400);
			}

			reducedMotion.addEventListener('change', () => {
				if (reducedMotion.matches) {
					window.clearInterval(timer);
					timer = undefined;
				} else {
					startAnimation();
				}
			});

			renderBonsai();
			startAnimation();
		</script>
	</body>
</html>

<style>
	:global(body.home-page) {
		--electric-blue: #48b8ff;
		--signal-red: #ff496c;
		--dim-white: #aab3c5;
		min-height: 100vh;
		background: #05060a;
		color: #f4f6fb;
		font-family: var(--font-atkinson), sans-serif;
		font-size: 16px;
		line-height: 1.6;
	}

	:global(body.home-page) a {
		color: inherit;
	}

	:global(body.home-page) a:focus-visible,
	:global(body.home-page) button:focus-visible {
		outline: 2px solid var(--electric-blue);
		outline-offset: 4px;
	}

	.site-header,
	main,
	.site-footer {
		width: min(1120px, calc(100% - 64px));
		margin-inline: auto;
	}

	.site-header {
		min-height: 84px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid #1b1e28;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.04em;
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark-mark,
	.footer-mark {
		color: var(--signal-red) !important;
	}

	.wordmark-period,
	.red-period {
		color: var(--signal-red);
	}

	.site-header nav {
		display: flex;
		align-items: center;
		gap: clamp(18px, 3vw, 38px);
	}

	.nav-link {
		color: #9299a9 !important;
		font-size: 0.85rem;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.nav-link:hover,
	.nav-link.is-current {
		color: #f4f6fb !important;
	}

	.nav-link.is-current::before {
		content: "/";
		margin-right: 6px;
		color: var(--electric-blue);
	}

	.header-cta,
	.manifesto-link,
	.all-posts-link {
		color: var(--electric-blue) !important;
		font-size: 0.82rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.header-cta span,
	.manifesto-link span,
	.all-posts-link span {
		margin-left: 6px;
		color: var(--signal-red);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
		align-items: center;
		gap: clamp(48px, 8vw, 104px);
		padding-block: clamp(68px, 10vw, 128px) clamp(82px, 11vw, 142px);
	}

	.eyebrow,
	.section-index,
	.hero-meta,
	.bonsai-caption,
	.site-footer {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 25px;
		color: #9ba4b7;
		font-size: 0.67rem;
		letter-spacing: 0.12em;
	}

	.status-light {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--signal-red);
		box-shadow: 0 0 12px #ff496c99;
	}

	h1 {
		margin: 0;
		color: #f4f6fb;
		font-size: clamp(3.15rem, 6.3vw, 5.6rem);
		font-weight: 700;
		letter-spacing: -0.075em;
		line-height: 0.99;
	}

	h1 > span:first-of-type {
		color: var(--electric-blue);
	}

	.title-cursor {
		color: var(--signal-red);
		animation: cursor-blink 1.1s steps(2, start) infinite;
	}

	.hero-description {
		max-width: 455px;
		margin: 27px 0 0;
		color: var(--dim-white);
		font-size: 1rem;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 25px;
		margin-top: 33px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 20px;
		padding: 13px 17px;
		border: 1px solid var(--electric-blue);
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.button-primary {
		background: var(--electric-blue);
		color: #05060a !important;
	}

	.button-primary:hover {
		transform: translateY(-2px);
		background: #90d5ff;
	}

	.button-primary span {
		color: var(--signal-red);
	}

	.text-link {
		color: #aab3c5 !important;
		font-size: 0.82rem;
		text-decoration: none;
	}

	.text-link span {
		margin-left: 6px;
		color: var(--signal-red);
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		margin-top: 54px;
		color: #697184;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
	}

	.hero-meta > span:first-child {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.blue-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--electric-blue);
	}

	.bonsai-scene {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
	}

	#bonsai-tree {
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--electric-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: clamp(0.62rem, 1vw, 0.78rem);
		font-weight: 600;
		line-height: 1.48;
		text-align: center;
		text-shadow: 0 0 10px #48b8ff40;
		white-space: pre;
	}

	:global(.tree-branch) {
		color: #8b6847;
		text-shadow: none;
	}

	:global(.tree-trunk) {
		color: #c0925e;
		text-shadow: none;
	}

	:global(.tree-leaf) {
		color: #6f9b55;
		text-shadow: 0 0 10px #6f9b5526;
	}

	:global(.tree-leaf-light) {
		color: #a7bd74;
		text-shadow: 0 0 9px #a7bd7430;
	}

	:global(.tree-pot) {
		color: #8b7560;
		text-shadow: none;
	}

	.bonsai-caption {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
		color: #798194;
		font-size: 0.72rem;
		text-align: center;
	}

	.caption-mark {
		color: var(--signal-red);
	}

	.manifesto {
		display: grid;
		grid-template-columns: 0.75fr 1.6fr auto;
		align-items: start;
		gap: 36px;
		padding-block: 30px 62px;
		border-top: 1px solid #222632;
		border-bottom: 1px solid #222632;
	}

	.section-index {
		margin: 5px 0 0;
		color: var(--electric-blue);
		font-size: 0.62rem;
		letter-spacing: 0.11em;
		white-space: nowrap;
	}

	.section-index span {
		color: var(--signal-red);
	}

	.manifesto h2,
	.latest h2 {
		margin: 0;
		color: #f4f6fb;
		font-size: clamp(1.55rem, 3vw, 2.3rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		line-height: 1.2;
	}

	.manifesto > div > p {
		max-width: 610px;
		margin: 14px 0 0;
		color: var(--dim-white);
		font-size: 0.94rem;
		line-height: 1.8;
	}

	.manifesto-link {
		margin-top: 8px;
	}

	.latest {
		padding-block: 76px 94px;
	}

	.latest-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 26px;
	}

	.latest-heading .section-index {
		margin: 0 0 12px;
	}

	.latest h2 {
		font-size: clamp(1.8rem, 4vw, 2.8rem);
	}

	.all-posts-link {
		margin-bottom: 7px;
	}

	.post-list {
		margin: 0;
		padding: 0;
		border-top: 1px solid #252a37;
		list-style: none;
	}

	.post-list li {
		border-bottom: 1px solid #252a37;
	}

	.post-link {
		display: grid;
		grid-template-columns: 58px minmax(0, 1fr) 132px 24px;
		align-items: center;
		gap: 14px;
		padding: 17px 6px;
		text-decoration: none;
		transition:
			background 160ms ease,
			padding 160ms ease;
	}

	.post-link:hover {
		padding-inline: 12px;
		background: #11141c;
	}

	.post-number,
	.post-date {
		color: #788194;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
	}

	.post-number {
		color: var(--signal-red);
	}

	.post-title {
		font-size: 1rem;
		font-weight: 600;
	}

	.post-arrow {
		color: var(--electric-blue);
		text-align: right;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.post-link:hover .post-arrow {
		transform: translate(2px, -2px);
		color: var(--signal-red);
	}

	.site-footer {
		display: flex;
		min-height: 80px;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		border-top: 1px solid #1b1e28;
		color: #798194;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer p span,
	.site-footer > a:last-child {
		color: var(--electric-blue);
		text-decoration: none;
	}

	@keyframes cursor-blink {
		to {
			visibility: hidden;
		}
	}

	@media (max-width: 850px) {
		.site-header,
		main,
		.site-footer {
			width: min(100% - 40px, 700px);
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			padding-block: 70px 78px;
		}

		.hero-copy {
			max-width: 620px;
		}

		.bonsai-scene {
			width: min(100%, 570px);
			justify-self: center;
		}

		#bonsai-tree {
			font-size: clamp(0.68rem, 1.7vw, 0.84rem);
		}

		.manifesto {
			grid-template-columns: 1fr 2fr;
			gap: 18px 28px;
		}

		.manifesto-link {
			grid-column: 2;
			margin-top: 0;
		}
	}

	@media (max-width: 560px) {
		.site-header,
		main,
		.site-footer {
			width: calc(100% - 36px);
